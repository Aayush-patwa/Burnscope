# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every variable below is read via os.environ somewhere
# in this codebase; none are guessed.

# --------------------------------------------------------------------------
# REQUIRED
# --------------------------------------------------------------------------

# Groq API key (https://console.groq.com/keys). Powers the agent loop
# (agent/loop.py) -- the app raises on startup without this.
# Free tier note: shared per Groq ORGANIZATION at ~200,000 tokens/day and
# 8,000 tokens/minute for the openai/gpt-oss-120b model used here. A single
# full conversation (photo -> verdict -> report -> email) costs roughly
# 30,000-90,000 tokens. A new key from the SAME org shares the same quota.
GROQ_API_KEY=

# --------------------------------------------------------------------------
# OPTIONAL -- database
# --------------------------------------------------------------------------

# Postgres connection string (for example a Neon "pooled" URL). When set, users,
# cases and sign-in sessions are stored there instead of the local SQLite file,
# so they survive restarts on hosts with a temporary disk. Leave empty to use
# SQLite (data/cases.db). Keep the sslmode=require part of a Neon URL.
DATABASE_URL=

# --------------------------------------------------------------------------
# OPTIONAL -- Gemini (clinic-facility classification)
# --------------------------------------------------------------------------

# Gemini API key (https://aistudio.google.com/apikey). Powers only
# tools/clinic_locator.py's facility-appropriateness classification -- a
# small, self-contained, single-turn call deliberately kept off Groq so it
# doesn't consume the main agent loop's rate-limit budget. Without this set,
# locate_nearby_clinics still works, but the filter fails open (keeps every
# facility OpenStreetMap returned, unfiltered) instead of raising.
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# OPTIONAL -- email (follow-up reminders + escalation report sending)
# --------------------------------------------------------------------------

# Without these two, agent/reminders.py and tools/escalate.py silently skip
# sending (they log "EMAIL_ADDRESS / EMAIL_APP_PASSWORD not set -- skipping
# send" and continue without error). Reports still generate for download;
# only the emailing feature is disabled.
#
# For Gmail: this must be a 16-character App Password, NOT your normal Gmail
# password -- Google requires 2-Step Verification to be turned on first, then
# create one at https://myaccount.google.com/apppasswords. Using a real
# account password here will not work (and would be a serious thing to leak
# if it ever were committed).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# --------------------------------------------------------------------------
# OPTIONAL -- Hugging Face
# --------------------------------------------------------------------------

# Only needed if downloading the segmentation base model (nvidia/mit-b1, a
# public model) without a token hits a Hugging Face rate limit on your
# network, or if that model's visibility ever changes. Get one at
# https://huggingface.co/settings/tokens (a "Read" token is enough).
HF_TOKEN=

# --------------------------------------------------------------------------
# OPTIONAL -- developer / debug overrides (agent/case_store.py, agent/loop.py,
# agent/context.py, app.py). None of these need to be set for normal use.
# --------------------------------------------------------------------------

# Use a different SQLite file instead of data/cases.db (e.g. for a demo
# database you can wipe without touching your real one). Ignored when
# DATABASE_URL is set.
# BURNSCOPE_DB=

# Set to 1/true/yes to print the raw model message and finish_reason for
# every Groq call (agent/loop.py). Verbose; off by default.
# BURNSCOPE_DEBUG=

# Overrides the token budget the agent trims conversation history to before
# each request (default 4300, sized for Groq's free-tier per-minute limit).
# Raise this only if you are on a paid Groq tier with a higher per-minute cap.
# BURNSCOPE_HISTORY_TOKEN_BUDGET=

# Set to any value to skip the background model warm-up thread app.py starts
# on launch (used by the automated tests; not recommended for normal use --
# without it, the first photo of the session pays the model-loading cost).
# BURNSCOPE_NO_WARMUP=
